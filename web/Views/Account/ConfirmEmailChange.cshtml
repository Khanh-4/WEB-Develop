@model string
@{
    ViewData["Title"] = "Email đã được xác nhận";
}

<div class="container py-5" style="max-width:520px">
    <div class="tx-card p-5 text-center">
        <div class="mb-4" style="width:64px;height:64px;background:rgba(52,211,153,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto">
            <i class="bi bi-check-circle-fill" style="font-size:2rem;color:#34d399"></i>
        </div>
        <h4 class="fw-bold mb-2" style="color:var(--text)">Email đã được cập nhật!</h4>
        <p style="color:var(--text-muted)">
            Địa chỉ email tài khoản của bạn đã được thay đổi thành<br>
            <strong style="color:var(--text)">@Model</strong>
        </p>
        <p class="small mb-4" style="color:var(--text-muted);opacity:.8">
            Vui lòng dùng email mới này để đăng nhập từ lần sau.
        </p>
        <a asp-controller="Account" asp-action="Profile" class="btn btn-gradient px-4">
            <i class="bi bi-person me-1"></i>Về trang cá nhân
        </a>
    </div>
</div>
