                <button class="btn glass" style="color:var(--text)" onclick="copyShareLink(this)">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
        </div>
        <div class="text-center">
            <a href="/Account/Login?returnUrl=/Builder" class="small" style="color:var(--text-muted)">
                Đăng nhập để lưu vĩnh viễn →
            </a>
        </div>`;
}

function copyShareLink(btn) {
    const input = document.getElementById('shareLinkInput');
    navigator.clipboard.writeText(input.value).then(() => {
        btn.innerHTML = '<i class="bi bi-check-lg text-success"></i>';
        setTimeout(() => btn.innerHTML = '<i class="bi bi-clipboard"></i>', 2000);
    });
}

// ── Compare / Snapshot ───────────────────────────────────────
const CMP_COLORS = ['#60a5fa', '#a855f7', '#4ade80', '#f97316'];

let snapshotState       = null;
let snapshotComponents  = null;
let compareChart        = null;
let compareUpdateTimer  = null;
let lastCompareRequest  = null; // stored for openFullComparePage

function closeComparePanel() {
    document.getElementById('comparePanel').style.display = 'none';
}

function openComparePanel(title, showClearBtn, showFullPageBtn) {
    document.getElementById('cmpPanelTitle').textContent = title;
    document.getElementById('cmpClearBtn').classList.toggle('d-none', !showClearBtn);
    document.getElementById('cmpFullPageWrap').classList.toggle('d-none', !showFullPageBtn);
    document.getElementById('comparePanel').style.display = 'flex';
    document.getElementById('compareLoading').style.display = '';
    document.getElementById('comparePrices').classList.add('d-none');
    document.getElementById('compareChartWrap').classList.add('d-none');
    document.getElementById('compareBenchmarks').classList.add('d-none');
    document.getElementById('compareTabRadar').classList.remove('d-none');
    document.getElementById('compareTabDetail').classList.add('d-none');
    document.querySelectorAll('.compare-tab').forEach((b, i) => {
        b.classList.toggle('active', i === 0);
        b.style.color = i === 0 ? '#c084fc' : 'rgba(255,255,255,.5)';
    });
}

function renderOptionLabels(labels) {
    const wrap = document.getElementById('cmpOptionLabels');
    wrap.innerHTML = labels.map((lbl, i) => {
        const c = CMP_COLORS[i % CMP_COLORS.length];
        return `<div style="padding:4px 12px;border-radius:8px;font-size:.75rem;font-weight:600;background:${c}18;border:1px solid ${c}50;color:${c}">${lbl}</div>`;
    }).join('');
}

// ── Snapshot mode (Build A vs current Build B) ────────────────
function snapshotBuild() {
    snapshotState      = JSON.parse(JSON.stringify(buildState));
    snapshotComponents = JSON.parse(JSON.stringify(selectedComponents));
    renderOptionLabels(['Build A (Snapshot)', 'Build B (Hiện tại)']);
    openComparePanel('So sánh Build', true, false);
    updateComparePanel();
    document.getElementById('snapshotBtn').innerHTML = '<i class="bi bi-pin-angle-fill me-1"></i>Snapshot đã lưu — đang so sánh';
}

function clearSnapshot() {
    snapshotState = null;
    snapshotComponents = null;
    closeComparePanel();
    document.getElementById('snapshotBtn').innerHTML = '<i class="bi bi-pin-angle me-1"></i>Snapshot Build A để so sánh';
    if (compareChart) { compareChart.destroy(); compareChart = null; }
}

function switchCompareTab(tab) {
    document.querySelectorAll('.compare-tab').forEach(b => {
        const active = b.dataset.tab === tab;
        b.classList.toggle('active', active);
        b.style.color = active ? '#c084fc' : 'rgba(255,255,255,.5)';
    });
    document.getElementById('compareTabRadar').classList.toggle('d-none', tab !== 'radar');
    document.getElementById('compareTabDetail').classList.toggle('d-none', tab !== 'detail');
}

async function updateComparePanel() {
    if (!snapshotState) return;
    clearTimeout(compareUpdateTimer);
    compareUpdateTimer = setTimeout(async () => {
        try {
            const r = await fetch('/Builder/CompareBuilds', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ buildA: snapshotState, buildB: buildState })
            });
            if (!r.ok) return;
            const data = await r.json();
            renderMultiResult([
                { label: 'Build A', data: data.a },
                { label: 'Build B', data: data.b },
            ]);
        } catch { /* silently ignore */ }
    }, 500);
}

// ── Multi-option mode (all tabs) ──────────────────────────────
async function openCompareOptions() {
    const active = builderOptions.filter(o => Object.keys(o.selectedComponents || {}).length > 0);
    if (active.length < 2) {
        showToast('Cần ít nhất 2 options có linh kiện để so sánh.', 'warning');
        return;
    }
    lastCompareRequest = { builds: active.map(o => ({ label: 'Option ' + o.label, state: o.buildState })) };
    renderOptionLabels(active.map(o => 'Option ' + o.label));
    openComparePanel(`So sánh ${active.length} options`, false, true);

    try {
        const r = await fetch('/Builder/CompareOptions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(lastCompareRequest)
        });
        if (!r.ok) throw new Error();
        const data = await r.json();
        renderMultiResult(data.options);
    } catch {
        document.getElementById('compareLoading').style.display = 'none';
        showToast('Lỗi tải dữ liệu so sánh.', 'warning');
    }
}

async function openFullComparePage() {
    if (!lastCompareRequest) return;
    try {
        const r = await fetch('/Builder/SaveCompare', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(lastCompareRequest)
        });
        if (!r.ok) throw new Error();
        const { token } = await r.json();
        window.open(`/Builder/Compare/${token}`, '_blank');
    } catch {
        showToast('Không thể mở trang so sánh.', 'warning');
    }
}

// ── Shared render (works for N options) ──────────────────────
function renderMultiResult(options) {
    document.getElementById('compareLoading').style.display = 'none';

    // Prices row
    const priceEl = document.getElementById('comparePrices');
    priceEl.innerHTML = options.map((o, i) => {
        const c = CMP_COLORS[i % CMP_COLORS.length];
        return `<div class="text-center flex-grow-1">
            <div style="font-size:.68rem;color:var(--text-muted)">${o.label}</div>
            <div class="fw-bold" style="font-size:.9rem;color:${c}">${fmtPrice(o.data?.totalPrice || 0)}</div>
        </div>`;
    }).join('<div style="color:var(--text-muted);padding-top:10px;font-size:.8rem">·</div>');
    priceEl.classList.remove('d-none');
    priceEl.style.display = 'flex';
    priceEl.style.justifyContent = 'center';
    priceEl.style.gap = '4px';

    // Radar chart
    const radarLabels = ['Gaming', 'Đa nhiệm', 'Lưu trữ', 'Tản nhiệt', 'Nâng cấp'];
    const datasets = options.map((o, i) => {
        const c = CMP_COLORS[i % CMP_COLORS.length];
        const r = o.data?.radar;
        return {
            label: o.label,
            data: r ? [r.gaming, r.multitasking, r.storage, r.thermal, r.upgrade] : [0,0,0,0,0],
            borderColor: c,
            backgroundColor: c + '20',
            pointBackgroundColor: c,
            borderWidth: 2,
        };
    });

    document.getElementById('compareChartWrap').classList.remove('d-none');
    if (compareChart) compareChart.destroy();
    compareChart = new Chart(document.getElementById('compareRadar').getContext('2d'), {
        type: 'radar',
        data: { labels: radarLabels, datasets },
        options: {
            responsive: true, maintainAspectRatio: false,
            scales: { r: {
                min: 0, max: 100,
                ticks: { display: false },
                grid: { color: 'rgba(255,255,255,.1)' },
                pointLabels: { color: 'rgba(255,255,255,.75)', font: { size: 11 } },
                angleLines: { color: 'rgba(255,255,255,.1)' },
            }},
            plugins: { legend: { labels: { color: 'rgba(255,255,255,.75)', font: { size: 11 } } } }
        }
    });

    // Benchmark rows
    const benchmarks = options.map(o => o.data?.benchmark);
    const bncEl = document.getElementById('compareBenchmarks');
    const benchDefs = [
        { label: 'CB R23 Multi', get: b => b?.cinebenchMulti, fmt: v => v?.toLocaleString() },
        { label: 'CS2 1080p',    get: b => b?.fpsCs2_1080p,    fmt: v => v ? v + ' fps' : null },
        { label: 'Cyberpunk 1080p', get: b => b?.fpsCyberpunk_1080p, fmt: v => v ? v + ' fps' : null },
    ];
    const benchRows = benchDefs
        .map(({ label, get, fmt }) => {
            const vals = benchmarks.map(b => get(b));
            if (!vals.some(v => v != null)) return '';
            const max = Math.max(...vals.map(v => parseFloat(v) || 0));
            const cells = vals.map((v, i) => {
                const c = CMP_COLORS[i % CMP_COLORS.length];
                const wins = parseFloat(v) === max && max > 0;
                return `<span style="color:${wins ? c : 'rgba(255,255,255,.6)'};font-weight:${wins ? 700 : 400}">${fmt(v) ?? '—'}</span>`;
            }).join('<span style="color:rgba(255,255,255,.2)"> · </span>');
            return `<div class="d-flex justify-content-between align-items-center mb-1 py-1" style="border-bottom:1px solid rgba(255,255,255,.06);font-size:.76rem">
                <span style="color:rgba(255,255,255,.5)">${label}</span>
                <div class="d-flex gap-2">${cells}</div>
            </div>`;
        }).join('');

    if (benchRows) {
        bncEl.innerHTML = `<div class="mt-2"><div class="mb-1 fw-semibold" style="font-size:.7rem;letter-spacing:.05em;color:var(--text-muted)">BENCHMARK</div>${benchRows}</div>`;
        bncEl.classList.remove('d-none');
    } else {
        bncEl.classList.add('d-none');
    }

    // Detail tab
    renderDetailTabMulti(options);
}

function renderDetailTabMulti(options) {
    const specRows = [
        ['CPU',         o => o.data?.specs?.cpu?.name],
        ['GPU',         o => o.data?.specs?.gpu?.name],
        ['RAM',         o => o.data?.specs?.memory?.name],
        ['Storage',     o => o.data?.specs?.storage?.name],
        ['PSU',         o => o.data?.specs?.psu?.name],
        ['Mainboard',   o => o.data?.specs?.motherboard?.name],
        ['Cooler',      o => o.data?.specs?.cooler?.name],
        ['Case',        o => o.data?.specs?.case?.name],
        ['TDP tổng',    o => o.data?.totalTDP ? o.data.totalTDP + 'W' : null],
        ['Tổng tiền',   o => fmtPrice(o.data?.totalPrice || 0)],
    ];
    const labelRow = options.map((o, i) => {
        const c = CMP_COLORS[i % CMP_COLORS.length];
        return `<div style="flex:1;font-size:.7rem;font-weight:700;color:${c};text-align:right">${o.label}</div>`;
    }).join('');

    let html = `<div class="d-flex mb-2" style="gap:6px"><div style="width:72px"></div>${labelRow}</div>`;
    for (const [lbl, getter] of specRows) {
        const vals = options.map(o => getter(o) ?? '—');
        const allSame = vals.every(v => v === vals[0]);
        const cells = vals.map((v, i) => {
            const c = CMP_COLORS[i % CMP_COLORS.length];
            return `<div style="flex:1;font-size:.74rem;text-align:right;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;color:${!allSame && v !== '—' ? c : 'rgba(255,255,255,.75)'}" title="${v}">${v}</div>`;
        }).join('');
        html += `<div class="d-flex align-items-center py-1" style="gap:6px;border-bottom:1px solid rgba(255,255,255,.06)">
            <div style="width:72px;font-size:.72rem;color:rgba(255,255,255,.4);flex-shrink:0">${lbl}</div>${cells}
        </div>`;
    }
    document.getElementById('compareDetailContent').innerHTML = html;
}

async function exportPdf() {
    const hasItems = Object.keys(selectedComponents).length > 0;
    if (!hasItems) { showToast('Chưa chọn linh kiện nào.', 'warning'); return; }

    const btns = document.querySelectorAll('#exportPdfBtn,#exportPdfBtnPartial');
    btns.forEach(b => { b.disabled = true; b.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo…'; });

    try {
        const r = await fetch('/Builder/ExportPdf', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(buildState)
        });
        if (!r.ok) { showToast('Lỗi tạo PDF, thử lại.', 'warning'); return; }
        const blob = await r.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `TechSpecs-BaoGia-${new Date().toISOString().slice(0,10)}.pdf`;
        a.click();
        URL.revokeObjectURL(url);
    } catch {
        showToast('Lỗi kết nối, thử lại.', 'warning');
    } finally {
        btns.forEach(b => { b.disabled = false; b.innerHTML = '<i class="bi bi-file-earmark-pdf me-2"></i>Xuất PDF'; });
        const full = document.getElementById('exportPdfBtn');
        if (full) full.innerHTML = '<i class="bi bi-file-earmark-pdf me-2"></i>Xuất báo giá PDF';
    }
}
</script>
}
