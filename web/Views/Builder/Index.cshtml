    if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo link…'; }

    const r = await fetch('/Build/ShareAnonymous', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': token },
        body: JSON.stringify({ buildJson: JSON.stringify(selectedComponents), name, ttlDays })
    });

    if (!r.ok) {
        if (btn) { btn.disabled = false; btn.innerHTML = '<i class="bi bi-link-45deg me-2"></i>Lấy link chia sẻ'; }
        showToast('Tạo link thất bại, thử lại.', 'danger');
