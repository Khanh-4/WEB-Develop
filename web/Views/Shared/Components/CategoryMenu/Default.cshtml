@{
    var renderAs = ViewBag.RenderAs as string ?? "Dropdown";
    var megaCats = new[] {
        ("cpu",         "bi-cpu",              "CPU"),
        ("motherboard", "bi-motherboard",      "Mainboard"),
        ("memory",      "bi-memory",           "RAM"),
        ("gpu",         "bi-gpu-card",         "Card đồ hoạ"),
        ("storage",     "bi-device-hdd",       "SSD / HDD"),
        ("psu",         "bi-lightning-charge", "Nguồn máy tính"),
        ("case",        "bi-box-seam",         "Vỏ case"),
        ("cooler",      "bi-thermometer-half", "Tản nhiệt"),
    };
}

<style>
.mega-heading { font-size:.68rem;font-weight:600;color:var(--text-muted);opacity:.7;letter-spacing:.08em; }
.mega-link {
    display:flex;align-items:center;gap:.5rem;
    min-width:0;                         /* allow flex item to shrink inside narrow grid col */
    color:var(--text-muted);font-size:.82rem;line-height:1.25;
    text-decoration:none;transition:all .15s;
    border-radius:.375rem;padding:.4rem .5rem;
    overflow-wrap:anywhere;              /* wrap long labels instead of overflowing */
}
.mega-link i { flex-shrink:0; }         /* keep icon at fixed width while label wraps */
.mega-link:hover { color:var(--text);background:rgba(168,85,247,.12); }
.mega-link-green:hover { color:#34d399;background:rgba(16,185,129,.12); }
.mega-divider { border-color:var(--border);margin:8px 0; }
.mega-right-col { border-left:1px solid var(--border); }
.mega-cta { transition:background .2s; }
.mega-cta:hover { background:rgba(168,85,247,.15); }
.mega-cta-indigo:hover { background:rgba(99,102,241,.15); }

.vmega-heading { font-size:.75rem;font-weight:700;color:var(--text-muted);opacity:.55;letter-spacing:.08em; }
.vmega-link {
    display:flex;align-items:center;gap:.75rem;
    min-width:0;
    color:var(--text-muted);font-size:.9rem;font-weight:500;line-height:1.25;
    text-decoration:none;transition:all .15s;
    border-radius:.5rem;padding:.45rem .75rem;
    overflow-wrap:anywhere;
}
.vmega-link i { flex-shrink:0; }
.vmega-link:hover { color:#c084fc;background:rgba(168,85,247,.15); }
.vmega-link-green:hover { color:#34d399;background:rgba(16,185,129,.15); }
.vmega-link-blue:hover  { color:#60a5fa;background:rgba(59,130,246,.15); }
.vmega-divider { border-color:var(--border);margin:12px 10px; }
</style>

@if (renderAs == "Dropdown")
{
    <div class="row g-0">
        <!-- Left: categories -->
        <div class="col-6 p-3">
            <p class="text-uppercase mega-heading mb-2">Linh kiện PC</p>
            <div class="row g-1">
                @foreach (var (cat, icon, label) in megaCats)
                {
                    <div class="col-6">
                        <a href="/Products?category=@cat" class="mega-link">
                            <i class="bi @icon" style="font-size:.95rem;color:#a855f7;width:18px;text-align:center"></i>
                            @label
                        </a>
                    </div>
                }
            </div>
            <hr class="mega-divider">
            <a href="/Products?category=prebuilt" class="mega-link mega-link-green">
                <i class="bi bi-pc-display" style="font-size:.95rem;color:#34d399;width:18px;text-align:center"></i>
                PC Dựng sẵn
            </a>
            <a href="/Products" class="mega-link">
                <i class="bi bi-grid-3x3-gap" style="font-size:.95rem;color:#a855f7;width:18px;text-align:center"></i>
                Tất cả sản phẩm
            </a>
        </div>
        <!-- Right: CTA -->
        <div class="col-6 p-3 d-flex flex-column gap-3 mega-right-col">
            <p class="text-uppercase mega-heading mb-0">Công cụ</p>
            <a href="/Builder" class="glass rounded-3 p-3 text-decoration-none d-block mega-cta">
                <i class="bi bi-tools" style="font-size:1.4rem;color:#a855f7"></i>
                <p class="fw-semibold mb-1 mt-2" style="font-size:.85rem;color:var(--text)">PC Builder</p>
                <p class="mb-0" style="font-size:.75rem;color:var(--text-muted)">Tự ráp cấu hình, AI gợi ý linh kiện tương thích</p>
            </a>
            <a href="/Build/Community" class="glass rounded-3 p-3 text-decoration-none d-block mega-cta mega-cta-indigo">
                <i class="bi bi-people" style="font-size:1.4rem;color:#6366f1"></i>
                <p class="fw-semibold mb-1 mt-2" style="font-size:.85rem;color:var(--text)">Cộng đồng</p>
                <p class="mb-0" style="font-size:.75rem;color:var(--text-muted)">Xem cấu hình từ cộng đồng, chia sẻ build của bạn</p>
            </a>
        </div>
    </div>
}
else if (renderAs == "Vertical")
{
    <div class="vertical-mega-menu d-flex flex-column glass h-100 p-2 py-3 rounded-4">
        <p class="text-uppercase vmega-heading mb-2 px-3">Danh mục</p>

        <a href="/Products?category=prebuilt" class="vmega-link vmega-link-green">
            <i class="bi bi-pc-display" style="font-size:1.1rem;color:#34d399;width:20px;text-align:center"></i>
            PC Dựng sẵn
        </a>

        @foreach (var (cat, icon, label) in megaCats)
        {
            <a href="/Products?category=@cat" class="vmega-link mt-1">
                <i class="bi @icon" style="font-size:1.1rem;color:#a855f7;width:20px;text-align:center"></i>
                @label
            </a>
        }

        <hr class="vmega-divider">

        <a href="/Products" class="vmega-link vmega-link-blue">
            <i class="bi bi-grid-3x3-gap" style="font-size:1.1rem;color:#3b82f6;width:20px;text-align:center"></i>
            Tất cả sản phẩm
        </a>
    </div>
}
